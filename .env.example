APP_ENV=local
LOG_LEVEL=INFO

# Supabase/PostgreSQL
DATABASE_URL=postgresql+psycopg2://postgres:password@db.example.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-or-anon-key

# Trading defaults
DEFAULT_TICKERS=AAPL,MSFT,NVDA,SPY,QQQ
INITIAL_CAPITAL_USD=200
MAX_POSITION_FRACTION=0.20
MAX_OPEN_POSITIONS=3
STOP_LOSS_PCT=0.04
TAKE_PROFIT_PCT=0.08

# Signal defaults
MOMENTUM_LOOKBACK_DAYS=20
VOLATILITY_LOOKBACK_DAYS=14
BUY_MOMENTUM_THRESHOLD=0.08
SELL_MOMENTUM_THRESHOLD=-0.05
MAX_VOLATILITY_THRESHOLD=0.60
